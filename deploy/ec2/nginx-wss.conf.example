# OPTIONAL — only needed if your frontend is served over https:// and therefore
# needs wss:// (browsers block ws:// from an https page — mixed content).
#
# Runs natively on the host (not in Docker) to avoid paying for another
# container's memory on a 1GB box. Install with: sudo dnf install -y nginx
# then copy this file to /etc/nginx/conf.d/blobwars.conf and get a cert with
# certbot (sudo dnf install -y certbot python3-certbot-nginx && sudo certbot --nginx).
#
# Until you set up TLS, the backend is reachable directly at ws://<ec2-ip>:2567
# — fine for an http:// frontend or local testing, not for a production https:// site.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      close;
}

server {
  listen 80;
  server_name your-backend-domain.example;

  location / {
    proxy_pass http://127.0.0.1:2567;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 3600s;   # long-lived websocket connections
  }
}
