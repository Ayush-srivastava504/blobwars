# Production values for the blobwars.site deployment.
# These are NEXT_PUBLIC_ vars — they are baked into the client bundle and are
# not secret, so committing this file is fine. If you'd rather manage them in
# Vercel's dashboard instead (Project Settings -> Environment Variables), the
# dashboard values take priority over this file at build time.

NEXT_PUBLIC_GAME_SERVER_WS=wss://api.blobwars.site
NEXT_PUBLIC_GAME_SERVER_HTTP=https://api.blobwars.site

# Fill in if you're using Google login; leave blank to disable it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
