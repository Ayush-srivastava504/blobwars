# Copy to .env on the EC2 instance and fill in real values before starting.

POSTGRES_USER=blobwars
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=blobwars

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value

GOOGLE_CLIENT_ID=

# Exact origin(s) of the deployed frontend, comma-separated, no trailing slash.
# Browsers will get CORS-blocked from talking to the backend if this doesn't match
# EXACTLY (including https:// and no trailing slash) whatever domain the browser
# bar shows when the frontend is loaded.
CORS_ORIGIN=https://blobwars.site,https://www.blobwars.site
