C
# Copy to .env on the EC2 instance and fill in real values before starting.

POSTGRES_USER=blobwars
POSTGRES_PASSWORD=YourStrongPassword123
POSTGRES_DB=blobwars

# Generate with: openssl rand -base64 48
JWT_SECRET=1jXm7XNNA6CsC1gzHmmdrPJLXBdFG/ldL5n8t6+18mQ9llRxl30qRFK10MmtO14a

GOOGLE_CLIENT_ID=

# Exact origin of the deployed frontend (no trailing slash), e.g. https://blobwars.vercel.app
# Browsers will get CORS-blocked from talking to the backend if this doesn't match.
CORS_ORIGIN=https://blobwars.site
NEXT_PUBLIC_GAME_SERVER_HTTP=https://api.blobwars.site
NEXT_PUBLIC_GAME_SERVER_WS=wss://api.blobwars.site
