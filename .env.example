# --- Postgres ---
POSTGRES_USER=blobwars
POSTGRES_PASSWORD=blobwars
POSTGRES_DB=blobwars
DATABASE_URL=postgresql://blobwars:blobwars@localhost:5432/blobwars

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Backend ---
PORT=2567
JWT_SECRET=change-me-in-prod
GOOGLE_CLIENT_ID=
# Local dev value below. In production (see .env.ec2.example) this must be:
# CORS_ORIGIN=https://blobwars.site,https://www.blobwars.site
CORS_ORIGIN=http://localhost:3000

# --- Frontend (must be prefixed NEXT_PUBLIC_ to reach the browser) ---
# Local dev values below. In production (Vercel) set these to:
# NEXT_PUBLIC_GAME_SERVER_WS=wss://api.blobwars.site
# NEXT_PUBLIC_GAME_SERVER_HTTP=https://api.blobwars.site
NEXT_PUBLIC_GAME_SERVER_WS=ws://localhost:2567
NEXT_PUBLIC_GAME_SERVER_HTTP=http://localhost:2567
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
